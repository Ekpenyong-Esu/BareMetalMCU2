---
title: DCMOTOR - brushed DC motors on L298N
---
%% Pins chosen from the free list in project.ioc.
%% PB4 = TIM3_CH1 (AF2), PC8 = TIM3_CH3 (AF2); both channels share TIM3.
%% REMOVE the ENA and ENB jumpers or the board ties enable high and ignores PWM.
%% Leave the module 5V pin unconnected - it is a regulator OUTPUT below 12 V in.
%% Grounds must be common or the direction inputs float.
%% IN1..IN4 link to OUT1..OUT4 to show which input drives which output; that
%% path is inside the H-bridge, not a wire you make.
flowchart LR
    subgraph PSU["External supply 6-12 V"]
        VIN["+V"]
        VGND["GND"]
    end

    subgraph MCU["STM32F429I-DISC1"]
        PB4["PB4 - TIM3_CH1"]
        PE2["PE2"]
        PE3["PE3"]
        PC8["PC8 - TIM3_CH3"]
        PE4["PE4"]
        PE5["PE5"]
        GND["GND"]
    end

    subgraph L298["L298N module - ENA/ENB jumpers REMOVED"]
        ENA["ENA"]
        IN1["IN1"]
        IN2["IN2"]
        IN3["IN3"]
        IN4["IN4"]
        ENB["ENB"]
        V12["12V in"]
        LGND["GND"]
        OUT1["OUT1"]
        OUT2["OUT2"]
        OUT3["OUT3"]
        OUT4["OUT4"]
    end

    MA["Motor A"]
    MB["Motor B"]

    PB4 --> ENA
    PE2 --> IN1
    PE3 --> IN2
    PC8 --> ENB
    PE4 --> IN3
    PE5 --> IN4

    VIN --> V12
    VGND --- LGND
    GND --- LGND

    IN1 --> OUT1
    IN2 --> OUT2
    IN3 --> OUT3
    IN4 --> OUT4

    OUT1 --> MA
    OUT2 --> MA
    OUT3 --> MB
    OUT4 --> MB
