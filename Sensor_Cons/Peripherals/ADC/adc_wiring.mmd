%% On-chip peripheral; nothing to wire except the signal you want to measure.
%% Channel map from Peripherals/ADC/adc_tutorial.ipynb: PA0-PA7, PB0-PB1, PC0-PC5.
%% PC3 (ADC123_IN13) is the only one of those still free in project.ioc.
%% Input must stay within 0 - 3.3 V; divide anything larger.
flowchart LR
    SRC["10k potentiometer across 3V3 and GND - wiper 0-3.3 V"]

    subgraph MCU["STM32F429I-DISC1 - analog pins"]
        AIN["PC3 - ADC123_IN13"]
        GND["GND"]
    end

    ADC["ADC1 12-bit SAR - VREF+ = VDDA 3.3 V"]
    TEMP["Internal temperature sensor - channel 16"]
    VBAT["Internal VBAT/4 - channel 18"]

    SRC --> AIN
    SRC --- GND
    AIN --> ADC
    TEMP --> ADC
    VBAT --> ADC
