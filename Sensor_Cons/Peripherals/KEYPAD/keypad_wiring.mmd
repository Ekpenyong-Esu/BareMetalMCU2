---
title: KEYPAD - 4x4 matrix
---
%% NO DOCUMENTED PINS - KeypadConfig_t takes any 8 GPIO.
%% Pins chosen from the free list in project.ioc.
%% Rows are driven one at a time; columns are read with internal pull-ups,
%% so a pressed key pulls its column low.
%% No external resistors and no power needed - the keypad is just switches.
%% Pressing two keys in the same column can look like a third key (ghosting)
%% unless the rows are driven open-drain.
flowchart LR
    subgraph MCU["STM32F429I-DISC1"]
        R0["PE2 - ROW0 output"]
        R1["PE3 - ROW1 output"]
        R2["PE4 - ROW2 output"]
        R3["PE5 - ROW3 output"]
        C0["PC11 - COL0 input pull-up"]
        C1["PC12 - COL1 input pull-up"]
        C2["PC13 - COL2 input pull-up"]
        C3["PD2 - COL3 input pull-up"]
    end

    subgraph KP["4x4 membrane keypad - 8 pin ribbon"]
        kR["Pins 1-4 : rows"]
        kC["Pins 5-8 : columns"]
        KEYS["1 2 3 A / 4 5 6 B / 7 8 9 C / * 0 # D"]
    end

    R0 --> kR
    R1 --> kR
    R2 --> kR
    R3 --> kR
    C0 --- kC
    C1 --- kC
    C2 --- kC
    C3 --- kC
    kR --- KEYS
    kC --- KEYS
