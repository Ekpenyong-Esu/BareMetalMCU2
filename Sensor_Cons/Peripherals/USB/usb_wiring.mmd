---
title: USB - on-board OTG HS in full-speed mode
---
%% ALREADY WIRED on the STM32F429I-DISC1 to the USB User micro-B socket.
%% Pins from project.ioc: PB14 = USB_OTG_HS_DM, PB15 = USB_OTG_HS_DP,
%% PB12 = ID, PB13 = VBUS, PC4 = power switch on, PC5 = overcurrent.
%% CONFLICT: the ILI9488 example uses PB12/PB13/PB14 - it cannot coexist with
%% USB on this board.
%% This is the USB *User* socket, NOT the ST-LINK socket you flash through.
%% In host mode the board must supply 5 V VBUS to the device, so power the
%% board from a supply that can deliver it.
flowchart LR
    subgraph MCU["STM32F429I-DISC1"]
        DM["PB14 - OTG_HS_DM"]
        DP["PB15 - OTG_HS_DP"]
        ID["PB12 - OTG_HS_ID"]
        VBUS["PB13 - OTG_HS_VBUS sense"]
        PWR["PC4 - VBUS power switch enable"]
        OC["PC5 - overcurrent flag"]
    end

    subgraph SOCK["USB User micro-AB socket"]
        sDM["D-"]
        sDP["D+"]
        sID["ID - grounded by an OTG cable"]
        sV["VBUS 5V"]
        sG["GND"]
    end

    subgraph MODES["Roles"]
        DEV["Device - CDC, MSC, HID"]
        HOST["Host - USB stick, keyboard"]
    end

    DM --- sDM
    DP --- sDP
    ID --- sID
    sV --> VBUS
    PWR -->|"switch 5 V out"| sV
    OC -.->|"fault"| PWR
    sID -->|"floating"| DEV
    sID -->|"grounded"| HOST
