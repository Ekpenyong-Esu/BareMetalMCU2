---
title: SYS - clock tree, nothing to wire
---
%% ON-CHIP ONLY. The 8 MHz source and the 32.768 kHz crystal are already on
%% the board; PH0/PH1 and PC14/PC15 carry them.
%% On the DISC1 the 8 MHz comes from the ST-LINK MCO, not a discrete crystal.
%% 168 MHz is the ceiling for this part; APB1 is limited to 42 MHz and APB2
%% to 84 MHz, which is why the timer clocks end up doubled.
%% That doubling is what TIM_Clock_GetHz accounts for.
flowchart LR
    subgraph SRC["Clock sources"]
        HSE["HSE 8 MHz - from ST-LINK MCO on PH0"]
        HSI["HSI 16 MHz internal RC"]
        LSE["LSE 32.768 kHz - PC14/PC15"]
        LSI["LSI ~32 kHz"]
    end

    PLL["PLL - M/N/P/Q"]
    SYSCLK["SYSCLK 168 MHz"]
    AHB["AHB /1 = HCLK 168 MHz"]

    subgraph APB["Peripheral buses"]
        APB1["APB1 /4 = 42 MHz - TIM2-7, TIM12-14"]
        APB2["APB2 /2 = 84 MHz - TIM1, TIM8-11"]
        T1["APB1 timer clock 84 MHz - doubled"]
        T2["APB2 timer clock 168 MHz - doubled"]
    end

    TICK["SysTick 1 ms + DWT microsecond counter"]

    HSE --> PLL
    HSI -.-> PLL
    PLL --> SYSCLK
    SYSCLK --> AHB
    AHB --> APB1
    AHB --> APB2
    APB1 --> T1
    APB2 --> T2
    AHB --> TICK
    LSE --> TICK
    LSI -.-> TICK
